# Etapa 1: Compilación
FROM eclipse-temurin:21-jdk AS build

LABEL authors="yasmanirosado"

WORKDIR /app

COPY .mvn/ .mvn/
COPY mvnw pom.xml ./

RUN chmod +x mvnw

COPY src/ src/

RUN ./mvnw -B -DskipTests package

# Etapa 2: Ejecución
FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=build \
    /app/target/AppBank-0.0.1-SNAPSHOT.jar \
    app.jar

ENV SPRING_PROFILES_ACTIVE=prod

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]